{
  "name": "infinite-canvas-desktop",
  "version": "0.0.4",
  "description": "无限画布-人工智能驱动的无限画布应用程序",
  "main": "out/main/main.js",
  "author": "王鑫凯",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "_dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "node scripts/dev.mjs preview",
    "build:api": "node scripts/build-api.mjs",
    "build:web": "node scripts/build-web.mjs",
    "build:all": "npm run build:api && npm run build:web && npm run build",
    "pack": "npm run build:all && electron-builder --dir",
    "dist": "npm run build:all && electron-builder",
    "dist:win": "npm run build:all && electron-builder --win",
    "dist:mac": "npm run build:all && electron-builder --mac",
    "dist:linux": "npm run build:all && electron-builder --linux"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "portfinder": "^1.0.32"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-vite": "^2.0.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10"
  },
  "build": {
    "appId": "com.infinitecanvas.app",
    "productName": "Infinite Canvas",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/api",
        "to": "resources/api"
      },
      {
        "from": "resources/web",
        "to": "resources/web"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}